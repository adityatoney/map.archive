# Database
DATABASE_URL=postgresql+asyncpg://medbed:medbed@db:5432/medbed
DATABASE_URL_SYNC=postgresql://medbed:medbed@db:5432/medbed

# Redis
REDIS_URL=redis://redis:6379/0

# Neo4j
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=medbed_neo4j_pass
NEO4J_ENABLED=true

# ML Service
ML_SERVICE_URL=http://ml:8001
MODEL_NAME=thomas-sounack/BioClinical-ModernBERT-base
MODEL_NAME_PROD=thomas-sounack/BioClinical-ModernBERT-large

# Encryption (generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
ENCRYPTION_KEY=change-me-generate-a-real-fernet-key

# External APIs (set to "mock" for local development without API keys)
UMLS_API_KEY=mock
ANTHROPIC_API_KEY=
ANTHROPIC_AUTH_TOKEN=
ANTHROPIC_MODEL=claude-sonnet-4-20250514
KEGG_API_ENABLED=true

# UMLS cache (Redis DB 1, 30-day TTL)
UMLS_CACHE_TTL=2592000
REDIS_CACHE_DB=1

# App
ENVIRONMENT=development
DEBUG=true
SECRET_KEY=change-me-to-a-random-secret-key
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Next.js
NEXTAUTH_SECRET=change-me-to-a-random-nextauth-secret
NEXTAUTH_URL=http://localhost:10513
API_URL=http://api:8000
NEXT_PUBLIC_API_URL=http://localhost:10511

# === Port Allocation (Project #5, base 10510) ===
MAP_PORT_DB=10510
MAP_PORT_API=10511
MAP_PORT_ML=10512
MAP_PORT_WEB=10513
MAP_PORT_REDIS=10514
MAP_PORT_NEO4J_HTTP=10515
MAP_PORT_NEO4J_BOLT=10516

# === SSD Bind Mount Path ===
SSD_DATA=/Volumes/DevSSD/docker-data
